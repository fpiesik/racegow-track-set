{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "RaceGOW: Setup .venv",
      "type": "shell",
      "command": "python",
      "args": ["scripts/setup_env.py"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": [],
      "presentation": {"reveal": "always", "panel": "dedicated", "clear": true}
    },
    {
      "label": "RaceGOW: Live view (choose part)",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": ["scripts/live_view.py", "${input:racegowPart}"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": [],
      "presentation": {"reveal": "always", "panel": "dedicated", "clear": true},
      "runOptions": {"instanceLimit": 1}
    },
    {
      "label": "RaceGOW: View once (choose part)",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": ["scripts/view.py", "${input:racegowPart}"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": []
    },
    {
      "label": "RaceGOW: Manufacturing plan only",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": ["scripts/build.py", "--manufacturing-only"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": []
    },
    {
      "label": "RaceGOW: Check build123d geometry",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": ["scripts/build.py", "--check"],
      "options": {"cwd": "${workspaceFolder}"},
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "RaceGOW: Run tests",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": ["-m", "pytest"],
      "options": {"cwd": "${workspaceFolder}"},
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "RaceGOW: Build STL + STEP",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": ["scripts/build.py", "--preview"],
      "options": {"cwd": "${workspaceFolder}"},
      "group": {"kind": "build", "isDefault": true},
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "racegowPart",
      "type": "pickString",
      "description": "RaceGOW part to show",
      "options": ["5way", "4way", "tee", "elbow", "cross", "fit_tests"],
      "default": "5way"
    }
  ]
}
